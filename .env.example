# docker compose up 拉取的镜像（GitHub Actions 自动构建推送）
VLM_IMAGE=zgzdocker/vlm-ws:dev
# 仅本地重建（docker-compose.build.yml）使用的构建参数
BASE_IMAGE=pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime
LOCAL_UID=1000
LOCAL_GID=1000
TZ=Asia/Shanghai
SHM_SIZE=16gb
JUPYTER_PORT=8888
TENSORBOARD_PORT=6006

