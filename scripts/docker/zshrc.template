# RMCS-style zsh bootstrap for the VLM workspace container.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="af-magic"
plugins=(git)

zstyle ':omz:update' mode disabled

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
else
    # Public CPU/CUDA images do not require Oh My Zsh to show the working directory.
    PROMPT='%F{cyan}%~%f %# '
fi

[ -f "$HOME/env_setup.zsh" ] && source "$HOME/env_setup.zsh"
[ -f "$HOME/.claude_env" ] && source "$HOME/.claude_env"

# <<< vlm-ws managed zshrc >>>
